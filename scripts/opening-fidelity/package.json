    "pixels": "node compare-pixels.mjs",
    "golden": "node capture-golden.mjs",
    "chapter-numbers": "node compare-chapter.mjs",
    "chapter-pixels": "node compare-chapter-pixels.mjs",
    "chapter-golden": "node capture-chapter-golden.mjs",
    "screen-qa": "node qa-onboarding-screen.mjs",
    "design-qa": "node qa-design-system.mjs",
    "home-qa": "node qa-home.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "playwright": "1.56.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-web": "0.21.2"
  }
}
