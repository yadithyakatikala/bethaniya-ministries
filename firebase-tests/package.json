{
  "name": "firebase-tests",
  "private": true,
  "version": "1.0.0",
  "description": "Emulator-backed security rules tests for Firestore and Storage (uses @firebase/rules-unit-testing against a real running Firebase Emulator Suite -- not a mock).",
  "scripts": {
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check \"src/**/*.ts\"",
    "format:write": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "firebase": "^12.18.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
