# Firebase Web config for the ADMIN dashboard.
# From Firebase Console > Project Settings > General > Your apps > SDK setup.
# NOT secret — access is controlled by Firestore/Storage security rules + Firebase Auth,
# never by hiding these values.
#
# Copy to .env.local for everyday local development (points at
# bethaniya-ministries-dev-58588, or leave the FIREBASE_* values blank to
# use the local Emulator Suite instead), or to .env.production for a
# production build (points at bethaniyaministries-production,
# VITE_APP_ENV=production, VITE_USE_FIREBASE_EMULATORS=false — see
# ENVIRONMENT.md "Wiring Firebase config into each app"). Never commit
# either file — both are gitignored by the root .env* pattern.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# development | staging | production
VITE_APP_ENV=development

# Use the local Firebase Emulator Suite instead of the real backend.
# Default: true. Safe placeholder config is used automatically for any of
# the VITE_FIREBASE_* values above that are left blank while this is true
# (see admin/src/services/firebase/app.ts). Set to "false" only once this
# app should talk to a real Firebase project.
VITE_USE_FIREBASE_EMULATORS=true

# --- Media uploads (Cloudinary) ----------------------------------------------
# OPTIONAL. Leave all three blank and the admin site shows a plain "uploading
# is not set up yet" notice where an upload button would be; pictures and songs
# can still be added by pasting a web address. docs/admin/MEDIA_UPLOADS.md has
# the click-by-click setup (free plan, about ten minutes).
#
# These three values are NOT secret. They are built into the published
# JavaScript, so anyone who opens the site can read them -- that is how
# "unsigned" uploading works, and the document above explains what it means
# and how to keep an eye on it.
#
#   VITE_CLOUDINARY_CLOUD_NAME    your account's "cloud name", shown in the
#                                 Cloudinary Console (see the document above)
#   VITE_CLOUDINARY_IMAGE_PRESET  name of an UNSIGNED upload preset that only
#                                 accepts images
#   VITE_CLOUDINARY_AUDIO_PRESET  name of an UNSIGNED upload preset that only
#                                 accepts audio (either preset may be left
#                                 blank to turn that kind of upload off)
#
# NEVER put the API secret, the API key, or the "CLOUDINARY_URL" connection
# string in any VITE_ variable or any file in this repository. The site refuses
# to switch uploading on if it finds one, and tells you to replace the secret.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_IMAGE_PRESET=
VITE_CLOUDINARY_AUDIO_PRESET=
