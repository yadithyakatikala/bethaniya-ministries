# Firebase Web config for the ADMIN dashboard.
# From Firebase Console > Project Settings > General > Your apps > SDK setup.
# NOT secret — access is controlled by Firestore/Storage security rules + Firebase Auth,
# never by hiding these values. Copy to .env.local and fill in real values (gitignored).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# development | staging | production
VITE_APP_ENV=development
