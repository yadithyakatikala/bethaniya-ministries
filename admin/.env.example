# Firebase Web config for the ADMIN dashboard.
# From Firebase Console > Project Settings > General > Your apps > SDK setup.
# NOT secret — access is controlled by Firestore/Storage security rules + Firebase Auth,
# never by hiding these values. Copy to .env.local and fill in real values (gitignored).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# development | staging | production
VITE_APP_ENV=development

# Use the local Firebase Emulator Suite instead of the real backend.
# Default: true. Safe placeholder config is used automatically for any of
# the VITE_FIREBASE_* values above that are left blank while this is true
# (see admin/src/services/firebase/app.ts). Set to "false" only once this
# app should talk to a real Firebase project.
VITE_USE_FIREBASE_EMULATORS=true
