.firebaserc

# Environment secrets (never commit real values) -- broad .env* glob so a
# new per-environment file (.env.production, .env.staging, ...) is safe by
# default and never needs a new gitignore line added after the fact; only
# the checked-in *.example templates are re-included below.
.env*
!.env.example

# Service account keys — NEVER commit these
*serviceAccountKey*.json
*firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist

# Testing / coverage
coverage/
*.lcov

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# TypeScript build info
*.tsbuildinfo

# EAS
.eas/
