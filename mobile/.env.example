# Firebase Web/Expo config for the MOBILE app.
# These values come from Firebase Console > Project Settings > General > Your apps > SDK setup.
# They are NOT secret (they identify which Firebase project to talk to; access is controlled by
# Firestore/Storage security rules and Firebase Auth, not by hiding these values).
#
# Copy this file to .env.local for everyday local development (points at
# bethaniya-ministries-dev-58588, or leave the FIREBASE_* values blank to
# use the local Emulator Suite instead), or to .env.production for a
# production build (points at bethaniyaministries-production,
# EXPO_PUBLIC_APP_ENV=production, EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
# -- see ENVIRONMENT.md "Wiring Firebase config into each app"). Never
# commit either file -- both are gitignored by the root .env* pattern,
# same as this file's own real-value counterpart always has been.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Which Firebase environment this build targets: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Use the local Firebase Emulator Suite instead of the real backend.
# Default: true. Safe placeholder config is used automatically for any of
# the EXPO_PUBLIC_FIREBASE_* values above that are left blank while this is
# true (see mobile/src/services/firebase/app.ts). Set to "false" only once
# this app should talk to a real Firebase project.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true

# Override the emulator host (e.g. your Mac's LAN IP for a real device on
# the same Wi-Fi). Leave unset for iOS simulator / web / Expo Go on the same
# machine -- Android emulator is auto-detected and uses 10.0.2.2.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
