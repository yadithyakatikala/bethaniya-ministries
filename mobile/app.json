{
  "expo": {
    "name": "Bethaniya Ministries",
    "slug": "bethaniya-ministries",
    "scheme": ["bethaniyaministries", "com.bethaniyaministries.app"],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bethaniyaministries.app",
      "buildNumber": "1",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "com.bethaniyaministries.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#273456",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-notifications",
      "./plugins/withReleaseSigning",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#273456"
        }
      ],
      "expo-asset",
      "expo-audio",
      "expo-web-browser"
    ],
    "extra": {}
  }
}
