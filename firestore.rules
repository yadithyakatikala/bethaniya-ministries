rules_version = '2';

/**
 * Firestore Security Rules — Bethaniya Ministries
 *
 * Strategy: deny-by-default (whitelist only). See /SECURITY.md and
 * FINAL_ARCHITECTURE_SPECIFICATION.md Section D for the full RBAC model this
 * implements.
 *
 * Status: these rules are tested — see /SECURITY.md's "Current rule
 * coverage" section for the real, emulator-backed test suite
 * (`firebase-tests/`, 55 passed / 2 documented skips as of Day 3) covering
 * authorized-vs-unauthorized access for every collection below.
 *
 * Roles: super_admin | content_admin | host | member
 * A user's role lives on their own /users/{uid} document (field: "role").
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -----------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Reads the caller's own user document to determine their role.
    // NOTE: this performs a `get()`, which counts against Firestore read
    // quotas/limits on every rule evaluation that calls it — acceptable at
    // V1 scale, revisit with custom claims if it becomes a cost/perf issue.
    function callerRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function hasRole(role) {
      return callerRole() == role;
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isContentAdminOrAbove() {
      return isSuperAdmin() || hasRole('content_admin');
    }

    function isHostOrAbove() {
      return isContentAdminOrAbove() || hasRole('host');
    }

    // Announcement field-level validation (Day 4). Re-validates the
    // client's input server-side, per FINAL_ARCHITECTURE_SPECIFICATION.md's
    // "Server-Side (Cloud Functions): re-validate all inputs (do not trust
    // client)" principle -- applied here via rules rather than a dedicated
    // Cloud Function, matching every other content collection (songs,
    // events), none of which has one; see /SECURITY.md's "Day 4" section
    // for the full reasoning. request.resource.data is always the
    // complete resulting document (not just changed fields), for both
    // create and update, so this also covers a partial update like the
    // publish/unpublish toggle. Length caps bound payload size given the
    // "mostly plain text" XSS risk assessment in FINAL_ARCHITECTURE_SPECIFICATION.md.
    function isValidAnnouncement(data) {
      return data.title is string
        && data.title.size() > 0 && data.title.size() <= 200
        && data.content is string
        && data.content.size() > 0 && data.content.size() <= 5000
        && data.published is bool
        && (!('imageUrl' in data) || data.imageUrl == null || data.imageUrl is string);
    }

    // Daily-verse field-level validation (Day 5). Same reasoning as
    // isValidAnnouncement() above, applied to daily_verses' fields.
    // Unlike announcements there is no `published` field to validate --
    // daily_verses has no publish/unpublish concept (see the RBAC table's
    // unconditional "Read" for that collection, and the read rule below,
    // which is unchanged). `date` must be a YYYY-MM-DD string, matching
    // what admin/src/features/daily-verses/validation.ts and
    // mobile/src/services/firebase/dailyVerses.ts both already assume.
    function isValidDailyVerse(data) {
      return data.reference is string
        && data.reference.size() > 0 && data.reference.size() <= 200
        && data.text is string
        && data.text.size() > 0 && data.text.size() <= 5000
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('imageUrl' in data) || data.imageUrl == null || data.imageUrl is string);
    }

    // Song field-level validation (Day 6). Same reasoning as
    // isValidAnnouncement() above, applied to songs' fields -- songs has
    // the same publish-concept RBAC shape as announcements (unlike
    // daily_verses), so `published` is validated the same way here too.
    // `audioUrl` is checked for string presence/length only, not URL
    // shape -- per storage.rules' own doc comment, song audio is always
    // an external URL (never uploaded to Firebase Storage), and this
    // mirrors imageUrl/coverUrl's existing string-only validation rather
    // than adding a new kind of check no other field here has.
    function isValidSong(data) {
      return data.title is string
        && data.title.size() > 0 && data.title.size() <= 200
        && data.artist is string
        && data.artist.size() > 0 && data.artist.size() <= 200
        && data.category is string
        && data.category.size() > 0 && data.category.size() <= 100
        && data.lyrics is string
        && data.lyrics.size() > 0 && data.lyrics.size() <= 10000
        && data.audioUrl is string
        && data.audioUrl.size() > 0 && data.audioUrl.size() <= 2000
        && data.published is bool
        && (!('coverUrl' in data) || data.coverUrl == null || data.coverUrl is string);
    }

    // Event field-level validation (Day 7). Same reasoning as
    // isValidAnnouncement() above, applied to events' fields -- events adds
    // isLive/youtubeUrl on top of the same publish-concept shape songs has.
    // This function is applied to BOTH the Content-Admin write branch and
    // the Host-only field-restricted update branch below (see the events
    // match block) -- request.resource.data is always the *complete*
    // resulting document for an update, not a diff, so a Host's
    // isLive/youtubeUrl-only update must still produce a fully valid
    // event (which it will, since title/location/description/startsAt/
    // published are carried over unchanged from the existing, already-
    // valid document -- a Host's update never touches them, enforced by
    // the .diff().affectedKeys().hasOnly([...]) check alongside this one).
    // youtubeUrl may be an empty string (no stream URL set yet) or an
    // http(s) URL -- never arbitrary text, but also never required.
    function isValidEvent(data) {
      return data.title is string
        && data.title.size() > 0 && data.title.size() <= 200
        && data.location is string
        && data.location.size() > 0 && data.location.size() <= 200
        && data.description is string
        && data.description.size() > 0 && data.description.size() <= 2000
        && data.startsAt is timestamp
        && data.published is bool
        && data.isLive is bool
        && data.youtubeUrl is string
        && data.youtubeUrl.size() <= 2000
        && data.youtubeUrl.matches('^$|^https?://.+');
    }

    // Day 9: validates a member's self-service update to their own user
    // document. Owners may only ever touch the fields listed in the
    // .hasOnly([...]) check on the `allow update` rule below -- this
    // function additionally re-validates the VALUE of each field that is
    // present in the resulting document, the same isValidX(data) pattern
    // used above for announcements/dailyVerse/songs/events. role, email,
    // phoneNumber, and createdAt are intentionally absent here: they are
    // never in the owner-editable field allowlist, so this function never
    // needs to validate them for a self-update.
    function isValidUserProfileSelfUpdate(data) {
      return data.displayName is string
        && data.displayName.size() > 0 && data.displayName.size() <= 200
        && (!('photoURL' in data)
            || data.photoURL == null
            || (data.photoURL is string && data.photoURL.size() <= 2000))
        && (!('languagePreference' in data)
            || data.languagePreference in ['en', 'te'])
        && (!('themePreference' in data)
            || data.themePreference in ['light', 'dark'])
        && (!('notificationsEnabled' in data)
            || data.notificationsEnabled is bool);
    }

    // ---- Default deny --------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }

    // ---- users -----------------------------------------------------
    // Members: read their own doc. Admins: read all.
    // Role field can only be changed by a Super Admin, and only for
    // SOMEONE ELSE (never by/for the user themselves — prevents both
    // self-elevation and self-demotion).
    match /users/{userId} {
      allow read: if isOwner(userId) || isContentAdminOrAbove();

      allow create: if isOwner(userId)
        && request.resource.data.role == 'member';

      // Day 9: an owner's self-update may ONLY touch the profile/
      // preference fields below (never role, email, phoneNumber, or
      // createdAt -- those stay server-controlled / Super-Admin-only),
      // and every field it does touch must additionally pass
      // isValidUserProfileSelfUpdate()'s value checks.
      //
      // Day 11: a Super Admin's role-change branch additionally requires
      // `!isOwner(userId)` -- a Super Admin may change ANOTHER user's
      // role, never their own, matching
      // functions/src/updateUserRole.ts's independent, server-side
      // self-demotion guard (that callable is the app's only intended
      // path for a role change; this rule is the defense-in-depth
      // boundary for a direct Firestore write bypassing it -- see that
      // file's header comment and admin/src/features/users/UsersPage.tsx's
      // disabled own-row selector for the other two layers of this same
      // guard). Without this, a Super Admin using the Firestore client
      // SDK directly (bypassing the callable and the UI entirely) could
      // still demote themselves out of Super Admin with no remaining
      // path back short of direct database access -- exactly what the
      // guard exists to prevent.
      allow update: if (isOwner(userId)
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['displayName', 'photoURL', 'languagePreference',
                         'themePreference', 'notificationsEnabled'])
          && isValidUserProfileSelfUpdate(request.resource.data))
        || (isSuperAdmin()
          && !isOwner(userId)
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['role']));

      allow delete: if isSuperAdmin();
    }

    // ---- announcements -----------------------------------------------
    // Day 4: create/update additionally re-validated via isValidAnnouncement().
    match /announcements/{announcementId} {
      allow read: if isContentAdminOrAbove()
        || (isSignedIn() && resource.data.published == true);
      allow create, update: if isContentAdminOrAbove()
        && isValidAnnouncement(request.resource.data);
      allow delete: if isContentAdminOrAbove();
    }

    // ---- daily_verses --------------------------------------------------
    // Day 5: create/update additionally re-validated via isValidDailyVerse().
    // Read is unchanged -- unconditional for any signed-in user, per the
    // RBAC table's daily_verses row (no publish gate, unlike announcements).
    match /daily_verses/{verseId} {
      allow read: if isSignedIn();
      allow create, update: if isContentAdminOrAbove()
        && isValidDailyVerse(request.resource.data);
      allow delete: if isContentAdminOrAbove();
    }

    // ---- songs -----------------------------------------------------
    // Day 6: create/update additionally re-validated via isValidSong().
    match /songs/{songId} {
      allow read: if isContentAdminOrAbove()
        || (isSignedIn() && resource.data.published == true);
      allow create, update: if isContentAdminOrAbove()
        && isValidSong(request.resource.data);
      allow delete: if isContentAdminOrAbove();
    }

    // ---- events -----------------------------------------------------
    // Day 7: create/update additionally re-validated via isValidEvent().
    match /events/{eventId} {
      allow read: if isContentAdminOrAbove()
        || (isSignedIn() && resource.data.published == true);
      // Content Admins manage events; Hosts may only toggle live-stream fields.
      allow create: if isContentAdminOrAbove() && isValidEvent(request.resource.data);
      allow update: if (isContentAdminOrAbove() && isValidEvent(request.resource.data))
        || (isHostOrAbove()
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['isLive', 'youtubeUrl'])
          && isValidEvent(request.resource.data));
      allow delete: if isContentAdminOrAbove();
    }

    // ---- notifications_log --------------------------------------------
    // Written only by Cloud Functions (via Admin SDK, which bypasses these
    // rules entirely) — clients never write directly.
    match /notifications_log/{notificationId} {
      allow read: if isHostOrAbove();
      allow write: if false;
    }

    // ---- audit_log -----------------------------------------------------
    // Written only by Cloud Functions. Super Admin read-only.
    match /audit_log/{entryId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ---- settings -----------------------------------------------------
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}
