rules_version = '2';

/**
 * Firestore Security Rules — Bethaniya Ministries
 *
 * Strategy: deny-by-default (whitelist only). See /SECURITY.md and
 * FINAL_ARCHITECTURE_SPECIFICATION.md Section D for the full RBAC model this
 * implements.
 *
 * Status: these rules are tested — see /SECURITY.md's "Current rule
 * coverage" section for the real, emulator-backed test suite
 * (`firebase-tests/`, 55 passed / 2 documented skips as of Day 3) covering
 * authorized-vs-unauthorized access for every collection below.
 *
 * Roles: super_admin | content_admin | host | member
 * A user's role lives on their own /users/{uid} document (field: "role").
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -----------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Reads the caller's own user document to determine their role.
    // NOTE: this performs a `get()`, which counts against Firestore read
    // quotas/limits on every rule evaluation that calls it — acceptable at
    // V1 scale, revisit with custom claims if it becomes a cost/perf issue.
    function callerRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function hasRole(role) {
      return callerRole() == role;
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isContentAdminOrAbove() {
      return isSuperAdmin() || hasRole('content_admin');
    }

    function isHostOrAbove() {
      return isContentAdminOrAbove() || hasRole('host');
    }

    // The complete set of roles this app recognises. Kept in sync with
    // functions/src/updateUserRole.ts's VALID_ROLES and admin/src/types'
    // UserRole union.
    //
    // Added during the V1 production-readiness audit, when role changes
    // moved from the updateUserRole callable (undeployable on the Spark
    // plan -- see admin/src/services/firebase/users.ts) to a direct,
    // rules-protected client write. The callable validated the incoming
    // role string itself; rules did not, because nothing untrusted could
    // reach the field. Now that a client writes it, this is the only thing
    // standing between a typo'd or malicious value and a `role` field that
    // matches no branch of hasRole() -- which would silently strip the
    // target user of every permission, including their own profile access,
    // with no path back except direct database surgery.
    function isValidRole(role) {
      return role in ['member', 'host', 'content_admin', 'super_admin'];
    }

    // ================================================================
    // M7 -- ACCOUNT STATUS, AND WHAT IT CAN AND CANNOT DO
    // ================================================================
    // A super admin can suspend a member. That suspension is an
    // APP-LEVEL one, not a Firebase Auth one, and the difference matters
    // enough to write down.
    //
    // Disabling an Auth account requires the Admin SDK, which requires a
    // deployed Cloud Function, which requires the Blaze plan -- this
    // project stays on Spark by explicit decision, so that door is shut
    // (same constraint as functions/src/updateUserRole.ts and
    // ./auditLog.ts). What is NOT shut is this: a suspended member can
    // still hold a valid token, but every rule below that calls
    // isActiveMember() refuses their writes on the SERVER. They cannot
    // post to the group chat, file a prayer request, comment, or report.
    // The mobile app also shows them a notice, but that is a courtesy;
    // this is the boundary.
    //
    // Reads are deliberately NOT gated. Suspension is about somebody
    // posting, not about cutting them off from scripture, songs or
    // service times.
    //
    // MISSING PROFILE DOCUMENT: get() on a document that does not exist
    // makes this expression error, which denies the request. That is the
    // safe direction, and it matches callerRole() above, which has always
    // had the same shape -- every signed-in member has a profile by the
    // time they can reach any of these screens (see
    // mobile/src/services/firebase/userProfile.ts's
    // ensureOwnProfileExists()).
    //
    // `accountStatus` is absent on every account created before M7, so
    // the default is 'active' -- a field nobody has set must never mean
    // "suspended".
    //
    // ----------------------------------------------------------------
    // M8 -- A TEMPORARY SUSPENSION EXPIRES HERE, ON THE SERVER
    // ----------------------------------------------------------------
    // A temporary suspension carries an `expiresAt`, and the moment
    // `request.time` is past it the member may write again. THAT
    // COMPARISON BELONGS IN THIS FILE and nowhere else: the obvious
    // alternative -- a scheduled job that flips accountStatus back --
    // needs a deployed Cloud Function, which needs Blaze; and an expiry
    // checked only in the app is worth nothing, because the app is the
    // party being restrained.
    //
    // A consequence worth writing down: an expired suspension leaves
    // `accountStatus: 'suspended'` on the document, because nothing
    // rewrites it. The stored field records what was DECIDED; whether
    // it is still IN FORCE is this function's answer. The dashboard and
    // the app both derive it the same way rather than trusting the
    // field alone.
    //
    // A permanent suspension has no `expiresAt`, so it never expires.
    // It ends when an administrator lifts it, and only then.
    // Read in two steps, `suspension` then `expiresAt`, rather than by a
    // nested path: a profile written before M8 has no `suspension` map
    // at all, and this way the missing-key default is plainly a default
    // rather than something to reason about. A document whose
    // accountStatus is 'active' never reaches the second half, so a
    // cleared `suspension: null` is not dereferenced.
    function suspensionIsInForce(profile) {
      return profile.get('accountStatus', 'active') == 'suspended'
        && (profile.get('suspension', {}).get('expiresAt', null) == null
            || request.time < profile.get('suspension', {}).get('expiresAt', null));
    }

    function isActiveMember() {
      return isSignedIn()
        && !suspensionIsInForce(
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data
           );
    }

    // Announcement field-level validation (Day 4). Re-validates the
    // client's input server-side, per FINAL_ARCHITECTURE_SPECIFICATION.md's
    // "Server-Side (Cloud Functions): re-validate all inputs (do not trust
    // client)" principle -- applied here via rules rather than a dedicated
    // Cloud Function, matching every other content collection (songs,
    // events), none of which has one; see /SECURITY.md's "Day 4" section
    // for the full reasoning. request.resource.data is always the
    // complete resulting document (not just changed fields), for both
    // create and update, so this also covers a partial update like the
    // publish/unpublish toggle. Length caps bound payload size given the
    // "mostly plain text" XSS risk assessment in FINAL_ARCHITECTURE_SPECIFICATION.md.
    function isValidAnnouncement(data) {
      return data.title is string
        && data.title.size() > 0 && data.title.size() <= 200
        && data.content is string
        && data.content.size() > 0 && data.content.size() <= 5000
        && data.published is bool
        && (!('imageUrl' in data) || data.imageUrl == null || data.imageUrl is string);
    }

    // Daily-verse field-level validation (Day 5). Same reasoning as
    // isValidAnnouncement() above, applied to daily_verses' fields.
    // Unlike announcements there is no `published` field to validate --
    // daily_verses has no publish/unpublish concept (see the RBAC table's
    // unconditional "Read" for that collection, and the read rule below,
    // which is unchanged). `date` must be a YYYY-MM-DD string, matching
    // what admin/src/features/daily-verses/validation.ts and
    // mobile/src/services/firebase/dailyVerses.ts both already assume.
    function isValidDailyVerse(data) {
      return data.reference is string
        && data.reference.size() > 0 && data.reference.size() <= 200
        && data.text is string
        && data.text.size() > 0 && data.text.size() <= 5000
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('imageUrl' in data) || data.imageUrl == null || data.imageUrl is string);
    }

    // Song field-level validation (Day 6). Same reasoning as
    // isValidAnnouncement() above, applied to songs' fields -- songs has
    // the same publish-concept RBAC shape as announcements (unlike
    // daily_verses), so `published` is validated the same way here too.
    // `audioUrl` is checked for string presence/length only, not URL
    // shape -- per storage.rules' own doc comment, song audio is always
    // an external URL (never uploaded to Firebase Storage), and this
    // mirrors imageUrl/coverUrl's existing string-only validation rather
    // than adding a new kind of check no other field here has.
    function isValidSong(data) {
      return data.title is string
        && data.title.size() > 0 && data.title.size() <= 200
        && data.artist is string
        && data.artist.size() > 0 && data.artist.size() <= 200
        && data.category is string
        && data.category.size() > 0 && data.category.size() <= 100
        && data.lyrics is string
        && data.lyrics.size() > 0 && data.lyrics.size() <= 10000
        && data.audioUrl is string
        && data.audioUrl.size() > 0 && data.audioUrl.size() <= 2000
        && data.published is bool
        && (!('coverUrl' in data) || data.coverUrl == null || data.coverUrl is string);
    }

    // Event field-level validation (Day 7). Same reasoning as
    // isValidAnnouncement() above, applied to events' fields -- events adds
    // isLive/youtubeUrl on top of the same publish-concept shape songs has.
    // This function is applied to BOTH the Content-Admin write branch and
    // the Host-only field-restricted update branch below (see the events
    // match block) -- request.resource.data is always the *complete*
    // resulting document for an update, not a diff, so a Host's
    // isLive/youtubeUrl-only update must still produce a fully valid
    // event (which it will, since title/location/description/startsAt/
    // published are carried over unchanged from the existing, already-
    // valid document -- a Host's update never touches them, enforced by
    // the .diff().affectedKeys().hasOnly([...]) check alongside this one).
    // youtubeUrl may be an empty string (no stream URL set yet) or an
    // http(s) URL -- never arbitrary text, but also never required.
    function isValidEvent(data) {
      return data.title is string
        && data.title.size() > 0 && data.title.size() <= 200
        && data.location is string
        && data.location.size() > 0 && data.location.size() <= 200
        && data.description is string
        && data.description.size() > 0 && data.description.size() <= 2000
        && data.startsAt is timestamp
        && data.published is bool
        && data.isLive is bool
        && data.youtubeUrl is string
        && data.youtubeUrl.size() <= 2000
        && data.youtubeUrl.matches('^$|^https?://.+');
    }

    // ================================================================
    // M8 -- WHAT A SUSPENSION RECORD HAS TO LOOK LIKE
    // ================================================================
    // `accountStatus` alone could only ever say WHETHER. A church
    // administrator also has to be able to answer: for how long, why,
    // and who decided -- and, for a temporary suspension, the app has
    // to be able to work out on its own when it is over. That is what
    // the `suspension` map carries.
    //
    // The two fields must AGREE, which is the main thing validated
    // here. A document saying 'suspended' with no terms, or carrying
    // terms while active, is a record nobody can act on: the dashboard
    // would not know what to display and suspensionIsInForce() above
    // would be reading a field that means nothing. So:
    //
    //   accountStatus 'active'     <->  suspension absent or null
    //   accountStatus 'suspended'  <->  a complete suspension map
    //
    // `expiresAt` is the load-bearing value. A temporary suspension
    // MUST carry one and it must be in the future -- a suspension that
    // has already expired when it is written is not a suspension, and
    // accepting one would let a mistyped date read as "suspended" in
    // the dashboard while the member writes on unhindered. A permanent
    // suspension must carry none, so that suspensionIsInForce() has
    // nothing to compare and the answer stays "yes" until an
    // administrator says otherwise.
    //
    // `byUid` must be the caller. Not because it protects anything --
    // only a super admin reaches this branch at all -- but because an
    // attribution that could name somebody else is worse than no
    // attribution: a church would read it as a fact about who acted.
    function isValidSuspensionRecord(suspension) {
      return suspension.keys().hasOnly(
               ['kind', 'reason', 'startedAt', 'expiresAt', 'byUid', 'byName'])
        && suspension.get('kind', '') in ['temporary', 'permanent']
        && suspension.get('startedAt', null) is timestamp
        && suspension.get('byUid', '') == request.auth.uid
        && (suspension.kind == 'permanent'
              ? suspension.get('expiresAt', null) == null
              : suspension.get('expiresAt', null) is timestamp
                && suspension.expiresAt > request.time)
        && (suspension.get('reason', null) == null
              || (suspension.reason is string && suspension.reason.size() <= 500))
        && (suspension.get('byName', null) == null
              || (suspension.byName is string && suspension.byName.size() <= 200));
    }

    function isValidSuspensionChange(data) {
      return data.get('suspension', null) == null
        ? data.accountStatus == 'active'
        : data.accountStatus == 'suspended'
          && isValidSuspensionRecord(data.suspension);
    }

    // Day 9: validates a member's self-service update to their own user
    // document. Owners may only ever touch the fields listed in the
    // .hasOnly([...]) check on the `allow update` rule below -- this
    // function additionally re-validates the VALUE of each field that is
    // present in the resulting document, the same isValidX(data) pattern
    // used above for announcements/dailyVerse/songs/events. role, email,
    // phoneNumber, and createdAt are intentionally absent here: they are
    // never in the owner-editable field allowlist, so this function never
    // needs to validate them for a self-update.
    function isValidUserProfileSelfUpdate(data) {
      // M6 BUG 1 + BUG 2: displayName is OPTIONAL here, and null is a
      // legitimate value for it.
      //
      // This used to read `data.displayName is string && size() > 0`
      // unconditionally, which made this whole function -- and therefore
      // EVERY self-update a member can make -- silently conditional on
      // their having a display name. Firebase Auth gives none to an
      // email/password account created without one, and
      // mobile/src/services/firebase/userProfile.ts's
      // ensureOwnProfileExists() faithfully stores that as `null`, so those
      // members could never change their Bible language, their theme, their
      // interface language or their notification setting. The Firestore SDK
      // applies such a write locally before the server rejects it and then
      // rolls it back, so the app looked like it had FORGOTTEN the setting
      // rather than like it had been denied -- which is what BUG 1 and BUG
      // 2 were, one permissions bug wearing a state-management costume.
      //
      // The value checks below are unchanged: an empty or over-long name is
      // still rejected, as is every invalid preference value. Only the
      // "you must have a name to have preferences" coupling is gone. See
      // firebase-tests/src/firestore.rules.test.ts's "a member whose
      // displayName was never set".
      return (!('displayName' in data)
            || data.displayName == null
            || (data.displayName is string
                && data.displayName.size() > 0
                && data.displayName.size() <= 200))
        && (!('photoURL' in data)
            || data.photoURL == null
            || (data.photoURL is string && data.photoURL.size() <= 2000))
        && (!('languagePreference' in data)
            || data.languagePreference in ['en', 'te'])
        // V2 split the single V1 language value into two independent
        // preferences -- an English interface over a Telugu Bible is the
        // product requirement, and one field could not express it. Both
        // are owner-editable and value-checked here; 'bilingual' is valid
        // for the Bible only, never for the interface. languagePreference
        // above is deliberately still accepted, so a V1 client writing it
        // is not rejected.
        && (!('appLanguage' in data) || data.appLanguage in ['en', 'te'])
        && (!('bibleMode' in data) || data.bibleMode in ['en', 'te', 'bilingual'])
        // M4 adds 'system' -- the Bible reader offers Light / Dark /
        // System and drives this same field rather than keeping a second
        // theme value of its own. ADDITIVE: 'light' and 'dark' are still
        // valid, so a V1/V2 client writing either is unaffected, and an
        // older client reading 'system' falls back to the device scheme
        // (its validator rejects the value locally, which its stored-
        // preference getter already treats as "nothing saved").
        && (!('themePreference' in data)
            || data.themePreference in ['light', 'dark', 'system'])
        && (!('notificationsEnabled' in data)
            || data.notificationsEnabled is bool)
        // M6 onboarding. A phone number is stored as the member typed it
        // (normalized client-side to digits and an optional leading '+'),
        // and the only thing worth enforcing here is that it is a short
        // string rather than a place to park arbitrary data -- E.164 tops
        // out at 15 digits, so 32 is generous. Null is allowed: a member
        // may withdraw a number they gave.
        && (!('phoneNumber' in data)
            || data.phoneNumber == null
            || (data.phoneNumber is string
                && data.phoneNumber.size() > 0
                && data.phoneNumber.size() <= 32))
        // Exactly the two values the church asked for, and no others --
        // this is a closed set, not free text.
        && (!('gender' in data) || data.gender in ['male', 'female'])
        // The onboarding marker is a timestamp or nothing. NOT checked
        // against request.time: the client writes serverTimestamp(), so
        // the server sets the value and a device's own clock never
        // reaches this field.
        && (!('profileCompletedAt' in data)
            || data.profileCompletedAt == null
            || data.profileCompletedAt is timestamp)
        // M7: which provider this member actually signs in with, so the
        // super admin's user list can say so instead of guessing. The
        // member's own client records it, because the alternative --
        // reading another user's Firebase Auth providerData -- needs the
        // Admin SDK and therefore a Cloud Function this project cannot
        // deploy. The closed set mirrors Firebase's own provider ids; an
        // account created before M7 simply has no value here, and the
        // admin page says "not recorded" rather than inventing one.
        && (!('authProvider' in data)
            || data.authProvider == null
            || data.authProvider in ['password', 'google.com', 'apple.com'])
        // M7: last time this member opened the app. Written by their own
        // client, at most once a day (see
        // mobile/src/services/firebase/userProfile.ts) -- it is a
        // "is this account still in use" signal for the admin list, not
        // a session log, and it must not become one write per launch.
        && (!('lastActiveAt' in data)
            || data.lastActiveAt == null
            || data.lastActiveAt is timestamp);
    }

    // M6 media post validation.
    //
    // THE URL RULES ARE THE POINT OF THIS FUNCTION. Nothing is uploaded
    // anywhere -- this project has no Cloud Storage bucket -- so a media
    // post is a link, and the link is the whole attack surface. https
    // only: http would be blocked by Android's cleartext policy anyway,
    // and every other scheme (javascript:, data:, file:, blob:, ...) is
    // refused by requiring the string to START with 'https://' rather
    // than by listing what is banned. A scheme nobody thought of cannot
    // get past a rule that names the one that is allowed.
    //
    // The matching client-side check, including the executable-extension
    // refusal and why each rejection exists, is in
    // mobile/src/features/media/mediaUrl.ts. That one is a courtesy to
    // the person filling in the form; this one is the boundary.
    //
    // `publishAt` is required and is a timestamp, because the read rule
    // compares it to request.time -- a post without one would be
    // unreadable by members and would look like a publishing bug.
    // `verseReference` and `verseText` are independently optional: a post
    // may cite a verse without quoting it.
    function isValidMediaPost(data) {
      return data.type in ['image', 'video']
        && data.mediaUrl is string
        && data.mediaUrl.size() > 0
        && data.mediaUrl.size() <= 2000
        && data.mediaUrl.matches('^https://[^\\s]+$')
        && data.caption is string
        && data.caption.size() <= 2000
        && data.published is bool
        && data.publishAt is timestamp
        && data.authorName is string
        && data.authorName.size() <= 200
        && (!('verseReference' in data)
            || data.verseReference == null
            || (data.verseReference is string && data.verseReference.size() <= 200))
        && (!('verseText' in data)
            || data.verseText == null
            || (data.verseText is string && data.verseText.size() <= 2000));
    }

    // M6 comment validation. Short, attributed, and not empty -- an empty
    // comment is a tap someone did not mean, and a 10,000-character one
    // is not a comment.
    function isValidMediaComment(data) {
      return data.text is string
        && data.text.size() > 0
        && data.text.size() <= 1000
        && data.authorUid is string
        && data.authorName is string
        && data.authorName.size() <= 200;
    }

    // ================================================================
    // M7 -- the group chat, the shared prayer wall, and reports.
    //
    // All three are MEMBER-AUTHORED, which nothing in this file was
    // before: every other content collection is written by an
    // administrator and read by the congregation. That changes what the
    // rules have to do, so the three validators below are stricter than
    // the admin-authored ones above -- they pin the author to the caller,
    // they pin the initial state, and they keep moderation fields out of
    // a member's reach.
    // ================================================================

    /**
     * One message in the church's group chat.
     *
     * `authorName` is denormalized onto the message because rules do not
     * let a member read another member's profile -- a lookup at read time
     * would not merely be slow, it would be denied. Same decision, same
     * reason, as isValidMediaPost()'s authorName above.
     *
     * `removed` is the moderation flag and must be FALSE on the document
     * a member writes. A message is never edited, by anyone: see the
     * match block below for why only removal exists.
     */
    function isValidCommunityMessage(data) {
      return data.text is string
        && data.text.size() > 0
        && data.text.size() <= 2000
        && data.authorUid is string
        && data.authorName is string
        && data.authorName.size() > 0
        && data.authorName.size() <= 200
        && data.createdAt is timestamp
        && data.removed is bool
        && data.keys().hasOnly(
             ['text', 'authorUid', 'authorName', 'createdAt', 'removed',
              'removedAt', 'removedByUid']);
    }

    /**
     * A prayer request on the shared wall.
     *
     * =================================================================
     * THE ANONYMOUS BRANCH IS THE WHOLE POINT OF THIS FUNCTION
     * =================================================================
     * When `anonymous` is true the document carries NO author identity:
     * no uid, no name, nothing. Not "a uid the app agrees not to
     * display" -- the field is refused outright, because any signed-in
     * member can read this collection and a field that is present is a
     * field that is readable, whatever the app chooses to render.
     *
     * The author is still known, and still has to be, or they could
     * neither edit nor delete their own request. Their identity lives in
     * prayer_requests/{requestId}/private/author, which only they and a
     * super admin can read -- see isPrayerRequestAuthor() and that match
     * block below.
     *
     * `anonymous` itself is NOT in the author's update allowlist. A
     * request published anonymously cannot later be de-anonymised, by
     * anyone, including its author: by then other people have replied to
     * it on the understanding that it was anonymous.
     */
    function isValidPrayerRequest(data) {
      return data.title is string
        && data.title.size() > 0 && data.title.size() <= 200
        && data.body is string
        && data.body.size() > 0 && data.body.size() <= 5000
        && (!('category' in data)
            || data.category == null
            || data.category in ['healing', 'family', 'guidance',
                                 'thanksgiving', 'provision', 'other'])
        && data.anonymous is bool
        && data.status in ['open', 'answered', 'closed']
        && data.createdAt is timestamp
        && data.removed is bool
        && (data.anonymous
              ? (!('authorUid' in data) || data.authorUid == null)
                && (!('authorName' in data) || data.authorName == null)
              : data.authorUid is string
                && data.authorUid.size() > 0
                && data.authorName is string
                && data.authorName.size() > 0
                && data.authorName.size() <= 200)
        && data.keys().hasOnly(
             ['title', 'body', 'category', 'anonymous', 'authorUid',
              'authorName', 'status', 'createdAt', 'updatedAt', 'removed',
              'removedAt', 'removedByUid']);
    }

    /**
     * A member's report of something they think should not be there.
     *
     * `status` and the three resolution fields are the ADMINISTRATOR's,
     * not the reporter's -- the create rule below refuses a report that
     * arrives already resolved, and the update rule lets nobody but an
     * administrator touch them.
     */
    function isValidReport(data) {
      return data.targetType in ['media', 'media_comment',
                                 'community_message', 'prayer_request']
        && data.targetId is string
        && data.targetId.size() > 0 && data.targetId.size() <= 200
        && (!('targetParentId' in data)
            || data.targetParentId == null
            || (data.targetParentId is string
                && data.targetParentId.size() <= 200))
        && data.reason in ['spam', 'harassment', 'hate', 'sexual',
                           'violence', 'misinformation', 'other']
        && (!('details' in data)
            || data.details == null
            || (data.details is string && data.details.size() <= 1000))
        && data.reporterUid is string
        && data.reporterUid.size() > 0
        && data.createdAt is timestamp
        && data.status in ['open', 'resolved', 'dismissed']
        && (!('resolutionNote' in data)
            || data.resolutionNote == null
            || (data.resolutionNote is string
                && data.resolutionNote.size() <= 1000))
        && data.keys().hasOnly(
             ['targetType', 'targetId', 'targetParentId', 'reason',
              'details', 'reporterUid', 'createdAt', 'status',
              'resolvedByUid', 'resolvedAt', 'resolutionNote']);
    }

    /**
     * Whether the caller wrote this prayer request.
     *
     * Reads the private author document rather than the public one,
     * because the public one deliberately does not say for an anonymous
     * request. Costs one document read per evaluation -- the same
     * tradeoff callerRole() above already accepts at this project's
     * scale -- and DENIES when the private document is missing, which is
     * the safe direction: a request nobody can prove they own is one
     * only an administrator can remove.
     */
    function isPrayerRequestAuthor(requestId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/prayer_requests/$(requestId)/private/author)
             .data.uid == request.auth.uid;
    }

    // The three moderation fields, and nothing else. Used by the group
    // chat and the prayer wall, which both hide removed content rather
    // than deleting it -- a deleted message takes the report that
    // referred to it out of an administrator's reach mid-review.
    function isModerationOnlyChange(before, after) {
      return after.diff(before).affectedKeys()
               .hasOnly(['removed', 'removedAt', 'removedByUid'])
        && after.removed is bool
        && (!('removedByUid' in after)
            || after.removedByUid == null
            || after.removedByUid == request.auth.uid)
        && (!('removedAt' in after)
            || after.removedAt == null
            || after.removedAt is timestamp);
    }

    // Prayer request field-level validation -- new V1 feature, added per
    // explicit owner decision (Plans/Prayers/Community are genuine new V1
    // features, not part of FINAL_ARCHITECTURE_SPECIFICATION.md's original
    // scope -- see PRODUCTION_READINESS.md). Same reasoning as
    // isValidAnnouncement() above, applied to a member's own prayer
    // requests -- fully private, never admin-managed (see the
    // /users/{userId}/prayers subcollection rule below).
    function isValidPrayer(data) {
      return data.text is string
        && data.text.size() > 0 && data.text.size() <= 2000
        && data.answered is bool
        && (!('answeredAt' in data) || data.answeredAt == null || data.answeredAt is timestamp);
    }

    // Community post field-level validation -- new V1 feature. Same shape
    // and reasoning as isValidAnnouncement() (admin-authored, member-read
    // when published -- see the RBAC/scope note above isValidPrayer()).
    function isValidCommunityPost(data) {
      return data.title is string
        && data.title.size() > 0 && data.title.size() <= 200
        && data.content is string
        && data.content.size() > 0 && data.content.size() <= 5000
        && data.published is bool
        && (!('imageUrl' in data) || data.imageUrl == null || data.imageUrl is string);
    }

    // Reading plan field-level validation -- new V1 feature. `dayCount`
    // must match the actual number of /plans/{planId}/days documents an
    // admin has created; that cross-collection invariant is enforced by
    // admin/src/services/firebase/plans.ts (which derives dayCount from
    // the real days subcollection rather than accepting it as free-typed
    // input), not by this rule -- Firestore rules cannot count a
    // subcollection's documents without an unbounded read, so this only
    // validates dayCount's shape (a non-negative integer), the same
    // boundary FINAL_ARCHITECTURE_SPECIFICATION.md's "client validates,
    // rules re-validate shape" principle uses elsewhere in this file.
    function isValidPlan(data) {
      return data.title is string
        && data.title.size() > 0 && data.title.size() <= 200
        && data.description is string
        && data.description.size() > 0 && data.description.size() <= 2000
        && data.category is string
        && data.category.size() > 0 && data.category.size() <= 100
        && data.dayCount is int && data.dayCount >= 0
        && data.order is int
        && data.published is bool
        && (!('coverImageUrl' in data) || data.coverImageUrl == null || data.coverImageUrl is string);
    }

    // A single day within a reading plan -- see the
    // /plans/{planId}/days/{dayId} rule below for why read access is
    // gated on the parent plan's own published flag rather than a
    // separate published field per day.
    function isValidPlanDay(data) {
      return data.dayNumber is int && data.dayNumber >= 1
        && data.title is string
        && data.title.size() > 0 && data.title.size() <= 200
        && data.scriptureReference is string
        && data.scriptureReference.size() > 0 && data.scriptureReference.size() <= 200
        && data.devotional is string
        && data.devotional.size() > 0 && data.devotional.size() <= 5000
        && (!('prayerPrompt' in data) || data.prayerPrompt is string && data.prayerPrompt.size() <= 1000);
    }

    // A member's own progress through a reading plan -- fully private,
    // same isOwner(userId)-only shape as prayers (see
    // /users/{userId}/planProgress/{planId} below).
    function isValidPlanProgress(data) {
      return data.startedAt is timestamp
        && data.currentDay is int && data.currentDay >= 1
        && data.completedDays is list
        && (!('lastReadAt' in data) || data.lastReadAt == null || data.lastReadAt is timestamp);
    }

    // ================================================================
    // M4 -- the Bible reader's own private, per-owner documents.
    //
    // Same authorization shape as prayers/planProgress above:
    // isOwner(userId) is the ENTIRE boundary, with no admin override.
    // A member's highlights, bookmarks, notes, display settings and
    // reading position are theirs alone, and every validator below is
    // additive -- nothing existing changes meaning.
    //
    // Every write is also field-locked with keys().hasOnly(), so a
    // client cannot smuggle arbitrary fields onto a document that rules
    // only ever re-read for shape. The prayers rule predates that
    // habit; these do not repeat the omission.
    // ================================================================

    /** The two bundled translations. NEVER 'bilingual': see
     *  mobile/src/services/firebase/readerAnnotations.ts -- an
     *  annotation belongs to one translation's verse. */
    function isTranslationId(value) {
      return value in ['en', 'te'];
    }

    /**
     * The verse an annotation points at. Bounds are canon facts, not
     * arbitrary caps: 150 is Psalms' chapter count and 176 is Psalm
     * 119's verse count, the two maxima in the 66-book canon (see
     * mobile/src/features/bible/books.ts). bookId is a slug like
     * 'song-of-solomon' -- never a localized book name.
     */
    function isVerseReference(data) {
      return isTranslationId(data.translationId)
        && data.bookId is string
        && data.bookId.size() > 0 && data.bookId.size() <= 40
        && data.bookId.matches('^[a-z0-9-]+$')
        && data.chapter is int && data.chapter >= 1 && data.chapter <= 150
        && data.verse is int && data.verse >= 1 && data.verse <= 176;
    }

    // The four named highlight tints -- kept in sync with
    // mobile/src/theme/tokens.ts's highlightTints.
    function isValidHighlight(data) {
      return isVerseReference(data)
        && data.colour in ['yellow', 'green', 'blue', 'pink']
        && data.createdAt is timestamp
        && data.keys().hasOnly(
             ['translationId', 'bookId', 'chapter', 'verse', 'colour', 'createdAt']);
    }

    // `note` is accepted but nothing in the app writes it: notes have
    // their own collection so that removing a bookmark cannot destroy a
    // written note, and so a note can exist without one. See
    // mobile/src/services/firebase/readerAnnotations.ts.
    function isValidBookmark(data) {
      return isVerseReference(data)
        && data.createdAt is timestamp
        && (!('note' in data)
            || (data.note is string && data.note.size() <= 2000))
        && data.keys().hasOnly(
             ['translationId', 'bookId', 'chapter', 'verse', 'note', 'createdAt']);
    }

    function isValidVerseNote(data) {
      return isVerseReference(data)
        && data.text is string
        && data.text.size() > 0 && data.text.size() <= 5000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.keys().hasOnly(
             ['translationId', 'bookId', 'chapter', 'verse', 'text',
              'createdAt', 'updatedAt']);
    }

    /**
     * The reader's display settings. Every field is a NAMED STEP from
     * mobile/src/theme/tokens.ts's readingScale, never a raw number, so
     * a synced document cannot carry an unreadable 4pt size or a
     * 3000dp column. Each field is optional because the client merges
     * only what changed.
     *
     * No theme field: the reader's Light/Dark/System control writes the
     * existing users/{uid}.themePreference, so there is one theme store
     * rather than two that can disagree.
     */
    function isValidReadingPrefs(data) {
      return (!('font' in data) || data.font in ['serif', 'sans'])
        && (!('size' in data)
            || data.size in ['xs', 'sm', 'md', 'lg', 'xl', 'xxl'])
        && (!('lineHeight' in data)
            || data.lineHeight in ['compact', 'normal', 'relaxed'])
        && (!('width' in data)
            || data.width in ['narrow', 'normal', 'wide'])
        && (!('layout' in data)
            || data.layout in ['stacked', 'sideBySide'])
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && data.keys().hasOnly(
             ['font', 'size', 'lineHeight', 'width', 'layout', 'updatedAt']);
    }

    /** The translation is the DOCUMENT ID here, not a field -- hence the
     *  narrower shape than isVerseReference() above. */
    function isValidReadingPosition(data) {
      return data.bookId is string
        && data.bookId.size() > 0 && data.bookId.size() <= 40
        && data.bookId.matches('^[a-z0-9-]+$')
        && data.chapter is int && data.chapter >= 1 && data.chapter <= 150
        && data.verse is int && data.verse >= 1 && data.verse <= 176
        && data.updatedAt is timestamp
        && data.keys().hasOnly(['bookId', 'chapter', 'verse', 'updatedAt']);
    }

    // ================================================================
    // M5 -- the automated Verse of the Day, and the Prophet Verse.
    //
    // TWO SEPARATE SYSTEMS, deliberately kept apart here as well as in
    // the data model and the UI:
    //
    //   settings/dailyVerse + verse_pool   the automated VOTD
    //   prophet_verses                     a distinct devotional record
    //
    // Everything below is ADDITIVE. No existing rule changes meaning:
    // daily_verses keeps exactly the permissions it had (an
    // administrator's explicit override still wins over the automation,
    // and still needs isContentAdminOrAbove()), and settings/church
    // remains super-admin-only -- see the /settings/dailyVerse block for
    // how a second, narrower match achieves that without widening the
    // generic settings rule.
    //
    // Members can READ what is public and can write NOTHING here: not
    // the configuration, not the pool, not a prophet verse, and not a
    // prophet verse's published flag.
    // ================================================================

    /**
     * The VOTD configuration document, settings/dailyVerse.
     *
     * `timezone` is pinned to the one value the app can actually honour.
     * The selection uses a fixed +05:30 offset
     * (mobile/src/features/daily-verses/votdDate.ts) because Hermes may
     * ship without a timezone database, so accepting an arbitrary zone
     * here would store a promise the app cannot keep.
     *
     * `seed` is restricted to plain printable characters -- it is hashed,
     * never rendered as markup, but a 10KB seed would be stored on a
     * document every member reads on every app open.
     */
    function isValidVotdConfig(data) {
      return data.enabled is bool
        && data.seed is string
        && data.seed.size() > 0 && data.seed.size() <= 64
        && data.seed.matches('^[A-Za-z0-9 ._-]+$')
        && data.poolVersion is int
        && data.poolVersion >= 1 && data.poolVersion <= 100000
        && data.timezone == 'Asia/Kolkata'
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && data.keys().hasOnly(
             ['enabled', 'seed', 'poolVersion', 'timezone', 'updatedAt']);
    }

    /**
     * One entry of the automated pool: a REFERENCE, never verse text.
     *
     * The bounds are the same canon facts isVerseReference() above uses
     * (150 = Psalms' chapters, 176 = Psalm 119's verses). There is no
     * translationId: the pool names a canonical verse, and each member's
     * own bibleMode decides which translation they read it in.
     *
     * Duplicating the Bible into Firestore is what this shape exists to
     * prevent -- see mobile/src/services/firebase/votd.ts.
     */
    function isValidVersePoolEntry(data) {
      return data.reference is string
        && data.reference.size() > 0 && data.reference.size() <= 200
        && data.bookId is string
        && data.bookId.size() > 0 && data.bookId.size() <= 40
        && data.bookId.matches('^[a-z0-9-]+$')
        && data.chapter is int && data.chapter >= 1 && data.chapter <= 150
        && data.verse is int && data.verse >= 1 && data.verse <= 176
        && data.order is int && data.order >= 0 && data.order <= 100000
        && data.active is bool
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && data.keys().hasOnly(
             ['reference', 'bookId', 'chapter', 'verse', 'order', 'active',
              'createdAt', 'updatedAt']);
    }

    /**
     * A Prophet Verse -- a separate devotional record, not a daily verse.
     *
     * `publishAt` IS A TIMESTAMP, not a date string. It is an instant
     * ("show this from 6am on Sunday"), compared with <= against
     * request.time below, unlike daily_verses' `date`, which is a
     * YYYY-MM-DD calendar key used for an exact match. The two are
     * deliberately different types because they answer different
     * questions.
     *
     * `imageUrl` must be an EXTERNAL HTTPS url. There is no Cloud
     * Storage bucket on this project's plan, so there are no uploads --
     * see storage.rules' own note about song audio, the same decision for
     * the same reason. http:// is refused outright: Android blocks
     * cleartext by default, so it would render as a broken image.
     *
     * Nothing on a server ever fetches this url; the device's own image
     * loader does, exactly as it already does for announcement images.
     */
    function isValidProphetVerse(data) {
      return data.title is string
        && data.title.size() > 0 && data.title.size() <= 200
        && data.reference is string
        && data.reference.size() > 0 && data.reference.size() <= 200
        && data.text is string
        && data.text.size() > 0 && data.text.size() <= 5000
        && data.published is bool
        && data.publishAt is timestamp
        && (!('attribution' in data)
            || data.attribution == null
            || (data.attribution is string && data.attribution.size() <= 200))
        && (!('imageUrl' in data)
            || data.imageUrl == null
            || (data.imageUrl is string
                && data.imageUrl.size() > 0 && data.imageUrl.size() <= 2000
                && data.imageUrl.matches('^https://.*$')))
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && data.keys().hasOnly(
             ['title', 'reference', 'text', 'attribution', 'imageUrl',
              'published', 'publishAt', 'createdAt', 'updatedAt']);
    }

    // ---- Default deny --------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }

    // ---- users -----------------------------------------------------
    // Members: read their own doc. Admins: read all.
    // Role field can only be changed by a Super Admin, and only for
    // SOMEONE ELSE (never by/for the user themselves — prevents both
    // self-elevation and self-demotion).
    match /users/{userId} {
      allow read: if isOwner(userId) || isContentAdminOrAbove();

      // Self-creation of one's own profile document. This is the app's ONLY
      // rules-governed path that creates /users/{uid}: the equivalent Cloud
      // Function trigger (functions/src/createUserProfile.ts) uses the Admin
      // SDK and bypasses rules entirely, and cannot be deployed at all under
      // this project's zero-billing constraint -- so in the deployed app it
      // is mobile's ensureOwnProfileExists() that actually runs (see
      // mobile/src/services/firebase/userProfile.ts). Nothing in the admin
      // dashboard creates user documents.
      //
      // The role pin has always been here, so no client can grant itself an
      // elevated role. The keys() allowlist was added during the V1
      // production-readiness audit: without it a member could create their
      // own profile carrying any number of arbitrary extra fields, and the
      // tight update rule below only governs LATER writes -- so anything
      // smuggled in at creation time would persist unchallenged. The list is
      // exactly the field set both creators write; hasOnly rather than
      // hasAll, so a caller may legitimately omit a field.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'member'
        && request.resource.data.keys().hasOnly(
             ['role', 'displayName', 'email', 'phoneNumber', 'createdAt']);

      // Day 9: an owner's self-update may ONLY touch the profile/
      // preference fields below (never role, email, phoneNumber, or
      // createdAt -- those stay server-controlled / Super-Admin-only),
      // and every field it does touch must additionally pass
      // isValidUserProfileSelfUpdate()'s value checks.
      //
      // Day 11: a Super Admin's role-change branch additionally requires
      // `!isOwner(userId)` -- a Super Admin may change ANOTHER user's
      // role, never their own, matching
      // functions/src/updateUserRole.ts's independent, server-side
      // self-demotion guard (that callable is the app's only intended
      // path for a role change; this rule is the defense-in-depth
      // boundary for a direct Firestore write bypassing it -- see that
      // file's header comment and admin/src/features/users/UsersPage.tsx's
      // disabled own-row selector for the other two layers of this same
      // guard). Without this, a Super Admin using the Firestore client
      // SDK directly (bypassing the callable and the UI entirely) could
      // still demote themselves out of Super Admin with no remaining
      // path back short of direct database access -- exactly what the
      // guard exists to prevent.
      //
      // M6 adds three owner-writable keys for the onboarding
      // questionnaire: 'gender' and 'profileCompletedAt' are new, and
      // 'phoneNumber' MOVES from server-controlled to owner-writable.
      // That last one is a deliberate widening, and a small one: a phone
      // number is the member's own contact detail, it is not an
      // authentication factor anywhere in this app (there is no OTP, no
      // phone sign-in provider), and nothing reads it to make a decision.
      // It used to be set once from whatever Firebase Auth happened to
      // know and then be unreachable, which is no use to a member who
      // signed up with an email address. 'email' and 'createdAt' stay
      // server-controlled, and 'role' remains Super-Admin-only.
      //
      // M7 adds two more owner-writable keys, 'authProvider' and
      // 'lastActiveAt'. Both are facts about the member's OWN session
      // that only their own client can observe -- see isActiveMember()
      // above and mobile/src/services/firebase/userProfile.ts's
      // recordSignInActivity(). Neither is read to make any decision;
      // they exist so the super admin's user list can say how somebody
      // signs in and whether the account is still in use, instead of
      // guessing. 'accountStatus' is deliberately NOT here: a member
      // lifting their own suspension is the whole thing it prevents.
      allow update: if (isOwner(userId)
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['displayName', 'photoURL', 'languagePreference',
                         'appLanguage', 'bibleMode',
                         'themePreference', 'notificationsEnabled',
                         'phoneNumber', 'gender', 'profileCompletedAt',
                         'authProvider', 'lastActiveAt'])
          && isValidUserProfileSelfUpdate(request.resource.data))
        || (isSuperAdmin()
          && !isOwner(userId)
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['role'])
          && isValidRole(request.resource.data.role))
        // M7: suspending and reinstating a member. A separate branch
        // from the role change above rather than a widened allowlist, so
        // one write can never do both -- "changed their role" and
        // "suspended them" are different decisions and should be
        // different actions in the audit trail. The same
        // `!isOwner(userId)` guard applies: a super admin cannot suspend
        // themselves out of the dashboard.
        //
        // What this actually enforces is described at isActiveMember()
        // above -- it stops a suspended member WRITING, on the server.
        // It does not and cannot disable their Firebase Auth account.
        //
        // M8 widens this branch by exactly one key. `accountStatus` says
        // WHETHER; `suspension` says which kind, until when, why, and
        // who decided -- and the two must move together or the record is
        // incoherent (a suspended account with no terms, or terms on an
        // active one). isValidSuspensionChange() below requires them to
        // agree, which is why they share a branch rather than getting
        // one each.
        || (isSuperAdmin()
          && !isOwner(userId)
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['accountStatus', 'suspension'])
          && isValidSuspensionChange(request.resource.data));

      allow delete: if isSuperAdmin();
    }

    // ---- users/{userId}/prayers -----------------------------------------
    // New V1 feature (Prayers) -- fully private per-owner, never
    // admin-managed. isOwner(userId) is the entire authorization boundary,
    // same as the parent /users/{userId} document itself.
    match /users/{userId}/prayers/{prayerId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidPrayer(request.resource.data);
    }

    // ---- users/{userId}/planProgress -------------------------------------
    // New V1 feature (Plans) -- a member's own progress through a reading
    // plan, fully private per-owner, same shape as prayers above.
    match /users/{userId}/planProgress/{planId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidPlanProgress(request.resource.data);
    }

    // ---- users/{userId}/highlights (M4 -- Bible reader) ------------------
    // Document id is `${translationId}_${bookId}_${chapter}_${verse}`, so a
    // verse can only ever have one highlight and re-colouring replaces it.
    // The id is NOT trusted as the source of those values -- every field is
    // validated on the document itself, above.
    match /users/{userId}/highlights/{highlightId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidHighlight(request.resource.data);
    }

    // ---- users/{userId}/bookmarks (M4 -- Bible reader) -------------------
    // Same deterministic id, which is what makes bookmarking idempotent:
    // a second "Bookmark" tap rewrites one document instead of adding a
    // duplicate record for the same user/verse/translation.
    match /users/{userId}/bookmarks/{bookmarkId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidBookmark(request.resource.data);
    }

    // ---- users/{userId}/verseNotes (M4 -- Bible reader) ------------------
    // A member's own notes on scripture. PRIVATE, like prayers: no admin
    // read, no shared read, no public commenting. Media comments are a
    // later milestone and will not live here.
    match /users/{userId}/verseNotes/{noteId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidVerseNote(request.resource.data);
    }

    // ---- users/{userId}/readingPrefs (M4 -- Bible reader) ----------------
    // One document ('reader') holding the reader's display settings. A
    // collection because `users/{uid}/readingPrefs` is an odd number of
    // path segments and therefore cannot itself be a document.
    match /users/{userId}/readingPrefs/{prefsId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidReadingPrefs(request.resource.data);
    }

    // ---- users/{userId}/readingPosition (M4 -- Bible reader) -------------
    // One document per translation, keyed by the translation id, so a
    // member keeps their place in both Bibles independently.
    match /users/{userId}/readingPosition/{translationId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isTranslationId(translationId)
        && isValidReadingPosition(request.resource.data);
    }

    // ---- announcements -----------------------------------------------
    // Day 4: create/update additionally re-validated via isValidAnnouncement().
    match /announcements/{announcementId} {
      // Host gets "read all" (including unpublished) per the RBAC table --
      // deliberately isHostOrAbove(), not isContentAdminOrAbove(); a prior
      // version of this rule used isContentAdminOrAbove() here, which left
      // Hosts seeing only published content, identical to a Member,
      // contradicting the documented table (found during the V1
      // production-readiness audit).
      allow read: if isHostOrAbove()
        || (isSignedIn() && resource.data.published == true);
      allow create, update: if isContentAdminOrAbove()
        && isValidAnnouncement(request.resource.data);
      allow delete: if isContentAdminOrAbove();
    }

    // ---- daily_verses --------------------------------------------------
    // Day 5: create/update additionally re-validated via isValidDailyVerse().
    // Read is unchanged -- unconditional for any signed-in user, per the
    // RBAC table's daily_verses row (no publish gate, unlike announcements).
    match /daily_verses/{verseId} {
      allow read: if isSignedIn();
      allow create, update: if isContentAdminOrAbove()
        && isValidDailyVerse(request.resource.data);
      allow delete: if isContentAdminOrAbove();
    }

    // ---- songs -----------------------------------------------------
    // Day 6: create/update additionally re-validated via isValidSong().
    match /songs/{songId} {
      // Host gets "read all" -- see the announcements rule above for why
      // this is isHostOrAbove(), not isContentAdminOrAbove().
      allow read: if isHostOrAbove()
        || (isSignedIn() && resource.data.published == true);
      allow create, update: if isContentAdminOrAbove()
        && isValidSong(request.resource.data);
      allow delete: if isContentAdminOrAbove();
    }

    // ---- events -----------------------------------------------------
    // Day 7: create/update additionally re-validated via isValidEvent().
    match /events/{eventId} {
      // Host gets "read all" -- see the announcements rule above for why
      // this is isHostOrAbove(), not isContentAdminOrAbove().
      allow read: if isHostOrAbove()
        || (isSignedIn() && resource.data.published == true);
      // Content Admins manage events; Hosts may only toggle live-stream fields.
      allow create: if isContentAdminOrAbove() && isValidEvent(request.resource.data);
      allow update: if (isContentAdminOrAbove() && isValidEvent(request.resource.data))
        || (isHostOrAbove()
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['isLive', 'youtubeUrl'])
          && isValidEvent(request.resource.data));
      allow delete: if isContentAdminOrAbove();
    }

    // ---- community -----------------------------------------------------
    // New V1 feature -- admin-authored posts (testimonies, updates), member-
    // read when published. Same read/write shape as announcements above
    // (deliberately NOT an open member-posting social feed -- see
    // PRODUCTION_READINESS.md's Community section for why).
    match /community/{postId} {
      // Host gets "read all" -- see the announcements rule above for why
      // this is isHostOrAbove(), not isContentAdminOrAbove().
      allow read: if isHostOrAbove()
        || (isSignedIn() && resource.data.published == true);
      allow create, update: if isContentAdminOrAbove()
        && isValidCommunityPost(request.resource.data);
      allow delete: if isContentAdminOrAbove();
    }

    // ---- plans -----------------------------------------------------------
    // New V1 feature -- admin-authored Bible-reading plans, member-read
    // when published. Same read/write shape as announcements/community.
    match /plans/{planId} {
      // Host gets "read all" -- see the announcements rule above for why
      // this is isHostOrAbove(), not isContentAdminOrAbove().
      allow read: if isHostOrAbove()
        || (isSignedIn() && resource.data.published == true);
      allow create, update: if isContentAdminOrAbove()
        && isValidPlan(request.resource.data);
      allow delete: if isContentAdminOrAbove();

      // A day's own visibility follows its PARENT plan's published flag,
      // not a separate field -- get() the parent doc rather than
      // duplicating `published` onto every day (avoids the two ever
      // drifting out of sync, at the cost of one extra read per day-list
      // rule evaluation, the same read-quota tradeoff callerRole() above
      // already accepts for this project's V1 scale).
      match /days/{dayId} {
        // Host gets "read all" -- see the announcements rule above for why
        // this is isHostOrAbove(), not isContentAdminOrAbove().
        allow read: if isHostOrAbove()
          || (isSignedIn()
              && get(/databases/$(database)/documents/plans/$(planId)).data.published == true);
        allow create, update: if isContentAdminOrAbove()
          && isValidPlanDay(request.resource.data);
        allow delete: if isContentAdminOrAbove();
      }
    }

    // ---- notifications_log --------------------------------------------
    // Written only by Cloud Functions (via Admin SDK, which bypasses these
    // rules entirely) — clients never write directly.
    match /notifications_log/{notificationId} {
      allow read: if isHostOrAbove();
      allow write: if false;
    }

    // ---- audit_log -----------------------------------------------------
    // Written only by Cloud Functions. Super Admin read-only.
    match /audit_log/{entryId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ---- verse_pool ----------------------------------------------------
    // M5: the automated Verse of the Day's pool of REFERENCES (never verse
    // text -- the text comes from the Bible bundled in the app).
    //
    // Members read only ACTIVE entries, which is also exactly what the
    // mobile query asks for (`where('active','==',true)` -- see
    // mobile/src/services/firebase/votd.ts), so a deactivated verse is
    // neither charged for nor visible. The admin dashboard needs the whole
    // list, including deactivated entries, which is why content admins get
    // an unconditional read. `host` deliberately does not: hosts manage
    // live streams, not scripture selection.
    match /verse_pool/{entryId} {
      allow read: if isContentAdminOrAbove()
        || (isSignedIn() && resource.data.active == true);
      allow create, update: if isContentAdminOrAbove()
        && isValidVersePoolEntry(request.resource.data);
      allow delete: if isContentAdminOrAbove();
    }

    // ---- prophet_verses ------------------------------------------------
    // M5: a SEPARATE content system from daily_verses -- its own
    // collection, its own permissions, its own admin page.
    //
    // A member may read a record only once it is BOTH published and due.
    // `request.time` is the SERVER's clock, so a member cannot see
    // tomorrow's scheduled verse by setting their phone's clock forward --
    // which is precisely why the schedule is enforced here and not only in
    // the client's query. (The matching client-side bound, and what it
    // does about a device clock that runs fast, is documented in
    // mobile/src/services/firebase/prophetVerses.ts.)
    //
    // Content admins read everything, because unpublished drafts and
    // future schedules are what their page exists to manage.
    match /prophet_verses/{verseId} {
      allow read: if isContentAdminOrAbove()
        || (isSignedIn()
            && resource.data.published == true
            && resource.data.publishAt <= request.time);
      allow create, update: if isContentAdminOrAbove()
        && isValidProphetVerse(request.resource.data);
      allow delete: if isContentAdminOrAbove();
    }

    // ---- media ---------------------------------------------------------
    // M6: the church's media feed -- images and videos an administrator
    // posts, with a caption and optionally a verse.
    //
    // PUBLIC READ, AND THAT IS DELIBERATE. Every other content collection
    // in this file requires isSignedIn(). This one does not, because the
    // brief is explicit that a signed-out visitor can view public media;
    // it is the church's public face. What stays behind sign-in is every
    // ACTION -- liking, saving, commenting -- because each of those is a
    // write into a signed-in member's own space. A reader who is not
    // signed in can see the feed and share a link, and nothing else.
    //
    // What is readable is still narrow: published AND due, measured on the
    // SERVER's clock via request.time, so a scheduled post cannot be
    // pulled forward by setting a phone's clock ahead. Content admins read
    // everything, because drafts and future schedules are what their page
    // manages.
    //
    // NO BINARY EVER ENTERS FIREBASE. `mediaUrl` is an external https
    // link; this project has no Cloud Storage bucket (Spark plan) and no
    // upload path. isValidMediaPost() below enforces the https-only rule
    // a second time, after mobile/src/features/media/mediaUrl.ts has
    // already enforced it client-side -- the client check is a courtesy
    // and this one is the boundary.
    match /media/{mediaId} {
      allow read: if isContentAdminOrAbove()
        || (resource.data.published == true
            && resource.data.publishAt <= request.time);
      allow create, update: if isContentAdminOrAbove()
        && isValidMediaPost(request.resource.data);
      allow delete: if isContentAdminOrAbove();

      // ---- media/{mediaId}/comments ------------------------------------
      // Readable by anyone who can read the post -- a comment is part of
      // what a post says. Written only by its own author, and NEVER
      // updated: an edited comment under someone else's post is a
      // moderation problem this app has no answer for, so the operation
      // does not exist. A content admin may delete any comment, which is
      // the moderation this app does have.
      //
      // `authorUid` must equal the caller. That is the whole ownership
      // boundary for creation, and it is checked on the incoming document
      // rather than inferred, so a member cannot post as somebody else.
      //
      // M7 adds isActiveMember() to the create rule -- a suspended member
      // may still READ the feed and its comments, and may not add to
      // them. That is a tightening, never a widening: every caller this
      // used to allow is still allowed unless a super admin has
      // explicitly suspended them. See isActiveMember() above.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isActiveMember()
          && request.resource.data.authorUid == request.auth.uid
          && isValidMediaComment(request.resource.data);
        allow update: if false;
        allow delete: if isContentAdminOrAbove()
          || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      }
    }

    // ---- users/{userId}/mediaLikes and /mediaSaves -----------------------
    // M6. A member's own likes and bookmarks, one document per post, with
    // THE MEDIA ID AS THE DOCUMENT ID.
    //
    // That choice is what makes these rules this short. Ownership is in
    // the PATH, so isOwner(userId) is the entire authorization boundary --
    // there is no field to spoof and no query to get wrong, and one member
    // writing into another's likes is not a rule that has to be
    // remembered, it is a path they cannot address. A deterministic id
    // also makes "liked the same post twice" unrepresentable, so the
    // collection cannot grow past one document per post per member.
    //
    // Same shape as users/{userId}/prayers above.
    match /users/{userId}/mediaLikes/{mediaId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['createdAt']);
    }

    match /users/{userId}/mediaSaves/{mediaId} {
      allow read, delete: if isOwner(userId);
      // A save carries a small copy of the post so the Saved screen is one
      // query rather than one read per save (see
      // mobile/src/services/firebase/media.ts). The copy is the member's
      // own data in their own space; it is bounded here so it stays a
      // list row and does not become somewhere to park arbitrary content.
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(
             ['type', 'mediaUrl', 'caption', 'createdAt'])
        && request.resource.data.type in ['image', 'video']
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.size() <= 2000
        && request.resource.data.mediaUrl.matches('^https://.+')
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 2000;
    }

    // ---- community_messages --------------------------------------------
    // M7: the church's group chat. The first collection in this file that
    // MEMBERS write to and every member reads.
    //
    // READ IS SIGNED-IN, NOT PUBLIC. The media feed is the church's public
    // face and is readable by a visitor; this is the congregation talking
    // among themselves, and it is not.
    //
    // THERE IS NO EDIT, FOR ANYONE. `allow update` is moderation-only:
    // the text, the author and the timestamp of a sent message are
    // immutable. An editable message means a reported message can be
    // rewritten into something innocuous before an administrator reads
    // the report, and it means the copy on one member's screen can differ
    // from the copy on another's. A member who got it wrong deletes their
    // message and sends another, which is what the delete rule is for.
    //
    // REMOVAL IS SOFT. An administrator sets `removed`, and the app shows
    // a tombstone in the message's place. A hard delete would take the
    // evidence out of the reviewing administrator's hands and leave the
    // report in /reports pointing at nothing.
    match /community_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isActiveMember()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.removed == false
        && !('removedAt' in request.resource.data)
        && !('removedByUid' in request.resource.data)
        && isValidCommunityMessage(request.resource.data);
      allow update: if isContentAdminOrAbove()
        && isModerationOnlyChange(resource.data, request.resource.data);
      allow delete: if isContentAdminOrAbove()
        || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    // ---- prayer_requests -------------------------------------------------
    // M7: the shared prayer wall. Distinct from /users/{uid}/prayers above,
    // which is a PRIVATE journal and stays exactly as it was -- a member
    // keeps their own list and, separately, may ask the church to pray.
    //
    // ===================================================================
    // ANONYMITY IS ENFORCED BY THE SHAPE OF THE DOCUMENT
    // ===================================================================
    // isValidPrayerRequest() refuses an anonymous request that carries an
    // author uid or an author name, so the identity is not merely hidden
    // by the client -- it is not in the document any member can read. See
    // that function's comment for why "store it but don't render it" is
    // not good enough.
    //
    // The author is recorded in the private/author subcollection below,
    // readable by the author and by a super admin (the explicit,
    // documented moderation path the brief allows), and by nobody else.
    match /prayer_requests/{requestId} {
      allow read: if isSignedIn();

      // A new request always starts open, un-removed, and -- when it is
      // not anonymous -- attributed to the caller and nobody else.
      allow create: if isActiveMember()
        && request.resource.data.status == 'open'
        && request.resource.data.removed == false
        && !('removedAt' in request.resource.data)
        && !('removedByUid' in request.resource.data)
        && (request.resource.data.anonymous
            || request.resource.data.authorUid == request.auth.uid)
        && isValidPrayerRequest(request.resource.data);

      // The author may reword their request and mark it answered. They
      // may NOT change `anonymous` -- see isValidPrayerRequest(). They
      // may not touch the moderation fields either; that branch is an
      // administrator's.
      allow update: if (isPrayerRequestAuthor(requestId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['title', 'body', 'category', 'status', 'updatedAt'])
          && isValidPrayerRequest(request.resource.data))
        || (isContentAdminOrAbove()
          && isModerationOnlyChange(resource.data, request.resource.data));

      allow delete: if isPrayerRequestAuthor(requestId)
        || isContentAdminOrAbove();

      // ---- prayer_requests/{requestId}/private/author ------------------
      // WHO WROTE IT. One document, one field, and the tightest read rule
      // in this file: the author themselves, or a super admin.
      //
      // Content admins deliberately do NOT get this. They can remove an
      // abusive prayer request without ever learning that the person who
      // wrote it is the member sitting three rows in front of them --
      // moderation does not require identity, and the brief only permits
      // the SUPER admin to have it.
      //
      // Immutable once written (`allow update: if false`), and created
      // in the same batch as the request itself, so a second member
      // cannot race in and claim authorship of somebody else's request.
      match /private/author {
        allow read: if isSuperAdmin()
          || (isSignedIn() && resource.data.uid == request.auth.uid);
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'createdAt']);
        allow update: if false;
        // Cleanup when a super admin removes the request itself --
        // Firestore does not cascade, so this would otherwise outlive
        // the document it describes.
        allow delete: if isSuperAdmin();
      }
    }

    // ---- users/{userId}/prayerRequests -----------------------------------
    // M7: a member's own index of the requests they have written, keyed by
    // the request id.
    //
    // WHY THIS EXISTS. An anonymous request says nothing about its author,
    // which is the point -- but the app still has to show ITS author an
    // edit and a delete button. Reading every request's private/author
    // document to find out would be one read per row. This is one read for
    // the whole screen, in the member's own private space, and it is the
    // same shape as users/{uid}/mediaLikes above.
    //
    // It holds no prayer text and no identity beyond the fact that this
    // member wrote this request -- which is a fact only this member and a
    // super admin can already establish.
    match /users/{userId}/prayerRequests/{requestId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['createdAt', 'anonymous'])
        && request.resource.data.anonymous is bool;
    }

    // ---- reports ---------------------------------------------------------
    // M7: what a member reports, and what an administrator does about it.
    //
    // MEMBERS WRITE AND NEVER READ. Not even their own report: a report
    // queue that a reporter can read back is a queue that tells them
    // whether anyone else has reported the same person, and that is not
    // information the congregation should have about each other. What the
    // app shows the reporter instead is their own marker document under
    // users/{uid}/reportedItems -- "you reported this" -- and nothing
    // about anybody else's.
    //
    // The three resolution fields are refused on creation and writable
    // only by an administrator, so a report cannot arrive pre-resolved.
    match /reports/{reportId} {
      allow read: if isContentAdminOrAbove();
      allow create: if isActiveMember()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && !('resolvedByUid' in request.resource.data)
        && !('resolvedAt' in request.resource.data)
        && !('resolutionNote' in request.resource.data)
        && isValidReport(request.resource.data);
      allow update: if isContentAdminOrAbove()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'resolvedByUid', 'resolvedAt',
                       'resolutionNote'])
        && request.resource.data.resolvedByUid == request.auth.uid
        && isValidReport(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // ---- users/{userId}/reportedItems ------------------------------------
    // M7: "you already reported this". The document id is
    // `${targetType}_${targetId}`, which makes reporting the same thing
    // twice unrepresentable rather than merely discouraged -- the same
    // deterministic-id decision as users/{uid}/mediaLikes above, and for
    // the same reason.
    match /users/{userId}/reportedItems/{itemKey} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['createdAt']);
    }

    // ---- settings -----------------------------------------------------
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ---- settings/dailyVerse -------------------------------------------
    // M5: the automated VOTD configuration.
    //
    // WHY A SECOND, NARROWER MATCH rather than widening the rule above.
    // Firestore evaluates EVERY matching rule and allows the request if
    // ANY of them allows it, so this block grants content admins access to
    // this ONE document while settings/church -- the church's public
    // identity, support email and logo -- stays super-admin-only. Changing
    // the generic rule to isContentAdminOrAbove() would have quietly
    // handed content admins the church's settings too.
    //
    // Read is not restated here: the generic rule above already allows any
    // signed-in member to read it, which is required -- every device needs
    // the seed and poolVersion to compute the same verse. It contains no
    // secrets.
    //
    // Delete is allowed because deleting this document is a RECOVERABLE
    // reset, not a loss: with no configuration the app falls back to
    // automation-on with the default seed (see
    // mobile/src/services/firebase/votd.ts's fetchVotdConfig()).
    match /settings/dailyVerse {
      allow create, update: if isContentAdminOrAbove()
        && isValidVotdConfig(request.resource.data);
      allow delete: if isContentAdminOrAbove();
    }
  }
}
